{
  "manifest_version": 3,
  "name": "SEI Notion — Integra processos do SEI com o Notion",
  "short_name": "SEI Notion",
  "version": "1.0.1",
  "description": "Liga processos do SEI às páginas do seu Notion. Token no navegador, sem servidor no meio.",
  "author": "Matheus Costa Frade",
  "homepage_url": "https://github.com/matheuscfrade/SEI-Notion",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "SEI Notion",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://api.notion.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
